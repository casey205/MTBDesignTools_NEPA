            </property>
            <property name="toolTip">
             <string>Check ONLY for layers where the mapped boundary has spatial uncertainty — e.g. undelineated wetland areas or LiDAR-derived stream centerlines. Do NOT use for authoritative FS corporate layers (NSO habitat, SHAB, Critical Habitat, Riparian Reserves) — their polygon edge IS the regulatory boundary.</string>
            </property>
            <property name="checked">
